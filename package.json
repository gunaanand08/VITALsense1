{
  "name": "cardiopulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CARDIOPULSE — portable ECG monitoring and heart rhythm analysis (educational prototype)",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake:device": "node scripts/fake-device.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.7",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/saira-condensed": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "bonjour-service": "1.4.4",
    "clsx": "2.1.1",
    "fastify": "5.12.8",
    "idb": "8.0.4",
    "jspdf": "4.2.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "three": "0.187.0",
    "ws": "8.23.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
