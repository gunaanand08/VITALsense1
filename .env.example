# Frontend (Vite) — baked into the bundle, so these must be public-safe.
# The publishable key is read-only: supabase/schema.sql grants it SELECT only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Cloud gateway (scripts/cloud-gateway.mjs) — server-side only.
# Never expose this key to the browser or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
